# Free Groq key: https://console.groq.com/keys
GROQ_API_KEY=paste_your_key_here
# Optional but recommended: Google Maps business data. Use ONE of these (leave the other blank):
# serper.dev (2,500 free searches) or serpapi.com (free plan, monthly searches). No card on either.
SERPER_API_KEY=
SERPAPI_KEY=
SENDER_NAME=David
DAILY_CAP=15

# OUTREACH_MODELS=   (optional; leave unset: the app asks Groq which models work and switches automatically)
# Groq free plan = 8,000 tokens/min per model. Raise only if you upgrade Groq (then e.g. 200000).
# GROQ_TPM=7000
